# Neon (serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clerk (authentication)
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# Polar (primary billing)
POLAR_ACCESS_TOKEN=pat_xxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
POLAR_PRO_PRODUCT_ID=prod_xxxxxxxxxxxx
POLAR_AGENCY_PRODUCT_ID=prod_xxxxxxxxxxxx

# Stripe (fallback billing)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_AGENCY_PRICE_ID=price_xxxxxxxxxxxx

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=hello@yourdomain.com

# Lovable AI Gateway (AI scope writer and cover letter)
LOVABLE_API_KEY=sk-xxxxxxxxxxxx

# App
# FRONTEND_URL is used server-side (CORS allow-list, redirect URLs in
# checkout/portal sessions). PORT is provided automatically by Render at
# runtime — do not set it yourself.
FRONTEND_URL=https://yourdomain.com

# Frontend build-time (Vite) — the API's Render URL. Leave unset for local
# dev (vite.config.ts proxies /api to http://localhost:3000).
VITE_API_BASE_URL=https://your-api.onrender.com
